# Frontend Configuration

# Backend API URL
VITE_API_BASE_URL=http://localhost:8000

# Application Configuration
VITE_APP_NAME=Universal Database Chat Assistant
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_QUERY_HISTORY=true
VITE_ENABLE_SAVED_QUERIES=true
VITE_ENABLE_DARK_MODE=true

# Default Settings
VITE_DEFAULT_RESULT_LIMIT=1000
VITE_DEFAULT_QUERY_TIMEOUT=30
